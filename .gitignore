# Dependencies and build output
node_modules/
dist/
# The Vite bundle, emitted into the installed layout foundation's static route
# resolves first (<install>/app/web). Source lives in web/.
#
# Anchored. An unanchored `app/` matches a directory of that name at *any*
# depth, which silently swallows `web/src/app/` — the frontend's own shell
# components — and they would never reach a commit.
/app/
out/
coverage/
*.tsbuildinfo

# Secrets and machine-local overrides (foundation DESIGN.md §3.5).
# The data root lives outside this repository — nothing under it is ever written here.
.env
.env.*
# ...except the committed template of which keys exist (never their values).
!.env.example
*.local.json

# Agent worktrees (created by Claude Code inside the repo directory)
.claude/worktrees/

# Editor / OS noise
.DS_Store
Thumbs.db
*.log
