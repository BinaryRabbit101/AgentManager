{
  "name": "agentmanager",
  "version": "0.1.0",
  "private": true,
  "description": "Manager for a roster of Claude agents pointed at projects, with remote start/stop.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "agentmanager": "dist/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "app",
    "config",
    "dist",
    "launch-core.vbs",
    "migrations",
    "scripts",
    "web"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "dev:web": "vite",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true }); require('node:fs').rmSync('app', { recursive: true, force: true })\"",
    "rebuild": "npm run clean && npm run build && npm run build:web",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "typecheck:electron": "tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --project server src/modules/runner/__spike__/sdk.spike.test.ts src/modules/orchestrator/__spike__/sdk.spike.test.ts src/modules/roster/draft.live.test.ts",
    "test:boundary": "vitest run --project server boundary src/lifecycle/bind.test.ts src/lifecycle/process.test.ts src/main.test.ts src/modules/runner/boundaries.test.ts",
    "checks:ui": "node scripts/ui-manual-checks.mjs",
    "checks:a11y": "vitest run --project web web/src/a11y",
    "checks:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Verify-Install.ps1",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "ci": "npm run lint && npm run typecheck && npm run typecheck:web && npm run typecheck:electron && npm run build && npm run build:web && npm test"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^9.39.1",
    "@tanstack/react-query": "^5.62.7",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^25.0.1",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^6.0.5",
    "vitest": "^3.2.4",
    "zustand": "^5.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.233",
    "@primno/dpapi": "^2.0.1",
    "better-sqlite3": "^13.0.3",
    "pino": "^9.14.0",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  }
}
