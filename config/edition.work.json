{
  "modules": {
    "remote": {
      "enabled": false
    }
  },
  "http": {
    "bind": "127.0.0.1"
  },
  "auth": {
    "mode": "env"
  },
  "policy": {
    "allowPermissionElevation": false
  },
  "runner": {
    "maxConcurrent": 1
  },
  "orchestrator": {
    "notify": {
      "enabled": false
    }
  }
}
